{
  "name": "@hrhv/git-mirror",
  "version": "0.1.0",
  "description": "Mirror any git repository (all branches, tags and refs) into a GitHub repository, creating it if needed",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "git-mirror": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hrhv/git-mirror.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "git",
    "mirror",
    "backup",
    "github",
    "cli"
  ],
  "author": "Harshit Budhraja",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
